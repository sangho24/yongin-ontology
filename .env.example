# 인증 환경변수 템플릿 — 실제 값은 .env.local(로컬) / Vercel 환경변수(운영)에만 둔다.

# 세션 JWT 서명 키. 32자 이상 필수.
#   생성: node scripts/auth-tool.mjs secret
AUTH_SECRET=

# 계정 목록. JSON 배열 한 줄.
#   항목 생성: node scripts/auth-tool.mjs user <아이디> <비밀번호> [표시명] [소속] [admin|viewer] [YYYY-MM-DD]
#   expiresAt(선택)이 지난 계정은 로그인이 거부된다 — 시연 계정에 권장.
# 예:
# AUTH_USERS=[{"id":"admin","name":"관리자","org":"PwC 분석팀","role":"admin","hash":"scrypt$16384$8$1$...$..."}]
AUTH_USERS=
